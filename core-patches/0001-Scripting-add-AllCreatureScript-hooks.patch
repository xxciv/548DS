+class AllCreatureScript : public ScriptObject
+{
+protected:
+    AllCreatureScript(const char* name);
+
+public:
+    bool IsDatabaseBound() const FINAL { return false; }
+
+    // Called after a creature has been added to the world (after its stats were initialized).
+    virtual void OnCreatureAddWorld(Creature* /*creature*/) { }
+
+    // Called before a creature is removed from the world.
+    virtual void OnCreatureRemoveWorld(Creature* /*creature*/) { }
+
+    // Called after Creature::SelectLevel() has (re)initialized level, health and damage (spawn, respawn, entry change).
+    virtual void OnCreatureSelectLevel(Creature* /*creature*/) { }
+
+    // Called when a creature is killed and a player (and their group) was rewarded for the kill.
+    virtual void OnCreatureKilled(Creature* /*killed*/, Player* /*rewardedPlayer*/) { }
+};
