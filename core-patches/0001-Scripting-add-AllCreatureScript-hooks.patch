+
+void ScriptMgr::OnCreatureSelectLevel(Creature* creature)
+{
+    ASSERT(creature);
+    FOREACH_SCRIPT(AllCreatureScript)->OnCreatureSelectLevel(creature);
+}
+
+void ScriptMgr::OnCreatureKilled(Creature* killed, Player* rewardedPlayer)
+{
+    ASSERT(killed);
+    FOREACH_SCRIPT(AllCreatureScript)->OnCreatureKilled(killed, rewardedPlayer);
+}
